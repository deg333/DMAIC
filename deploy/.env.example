# Copy to .env and edit: cp .env.example .env

# Domain name for the site. Its DNS A record must point at this server's IP address,
# and ports 80 and 443 must be open, so Caddy can get the HTTPS certificate.
DMAIC_DOMAIN=dmaic.example.com

# Image to run. To roll back, set a specific build, e.g. ghcr.io/deg333/dmaic:sha-1a2b3c4,
# then run ./deploy.sh again.
DMAIC_IMAGE=ghcr.io/deg333/dmaic:latest

# Optional settings:
# DMAIC_VOLUME=dmaic-data   # Docker volume holding the database
# KEEP_BACKUPS=10           # database backups kept in the volume's backups/ folder
# HTTP_PORT=80
# HTTPS_PORT=443
